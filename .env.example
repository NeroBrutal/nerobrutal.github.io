# Copy this file to .env. .env is gitignored.
#
# Anything prefixed PUBLIC_ is baked into the client JS bundle and visible to
# every visitor — never put API keys here. The OpenRouter key lives in the
# Cloudflare Worker in worker/ (set with `npx wrangler secret put
# OPENROUTER_API_KEY`); the site only needs the Worker's URL.
PUBLIC_AGENT_ENDPOINT=https://rashidh-agent-proxy.<your-subdomain>.workers.dev
